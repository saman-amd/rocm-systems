{
  "max_ticks": 100000,
  "num_threads": 1,
  "exec_mode": "functional",
  "vm": {
    "arch": "cdna4",
    "gpu": {
      "device": {
        "gpu_id": 38144,
        "gfx_target_version": 90500,
        "vendor_id": 4098,
        "device_id": 30112,
        "family_id": 160,
        "unique_id": 5929628898254127105,
        "marketing_name": "AMD Instinct MI350X",
        "simd_count": 1024,
        "max_waves_per_simd": 8,
        "num_shader_engines": 4,
        "num_shader_arrays_per_engine": 1,
        "num_cu_per_sh": 9,
        "simd_per_cu": 4,
        "wave_front_size": 64,
        "local_mem_size": 309220868096,
        "lds_size_kb": 160,
        "mem_width": 8192,
        "mem_clk_max": 1900,
        "l2_size_kb": 4096,
        "num_sdma_engines": 2,
        "num_sdma_xgmi_engines": 14,
        "num_sdma_queues_per_engine": 8,
        "num_cp_queues": 24,
        "max_engine_clk_fcompute": 2200,
        "capability": 2889327232,
        "capability2": 1,
        "debug_prop": 1494
      }
    }
  },
  "timing": {
    "_provenance": "issue_cycles for lane-parallel classes are per 16-lane pass (the model multiplies by wave_lanes/simd_lanes); scalar/branch entries are per instruction. clock_mhz and compute_units track vm.gpu.device (max_engine_clk_fcompute, simd_count/simd_per_cu = 1024/4 = 256 active CUs, not the 288 physical CUs the topology instantiates). global.bytes_per_cycle = 70% of 8192b x 1900MHz x 4 = 7.78 TB/s peak, over the 2.2 GHz shader clock. lds.bytes_per_cycle = 128 B/clk/CU x 256. dispatch_latency_cycles is one memory round trip, the shortest a dispatch can take: this model has no latency model, so the floor is the only place that cost appears. It is NOT launch overhead -- the clock deliberately does not advance between dispatches, so a launch costs nothing and kernel time is what is reported. See the timing-model design notes for the full derivation.",
    "model": "leaky",
    "clock_mhz": 2200,
    "machine": {
      "compute_units": 256,
      "simd_lanes": 16,
      "dispatch_latency_cycles": 900,
      "global": { "bytes_per_cycle": 2476 },
      "lds": { "bytes_per_cycle": 32768 },

      "none": { "ports": 1 },
      "unknown": { "issue_cycles": 64 },
      "vector_alu": { "issue_cycles": 1, "ports": 4 },
      "scalar_alu": { "issue_cycles": 1, "ports": 1 },
      "transcendental": { "issue_cycles": 4, "ports": 4 },
      "matrix_multiply": { "issue_cycles": 4, "ports": 4 },
      "local_data_share": { "ports": 1 },
      "lds_read": { "issue_cycles": 1 },
      "lds_write": { "issue_cycles": 1 },
      "vector_memory": { "ports": 1 },
      "vector_memory_read": { "issue_cycles": 2 },
      "vector_memory_write": { "issue_cycles": 2 },
      "vector_memory_atomic": { "issue_cycles": 4 },
      "scalar_memory": { "issue_cycles": 8, "ports": 1 },
      "tensor_memory": { "issue_cycles": 8 },
      "export": { "issue_cycles": 8, "ports": 1 },
      "branch": { "issue_cycles": 8, "ports": 1 },
      "wait_counter": { "issue_cycles": 1 },
      "delay_alu": { "issue_cycles": 1 },
      "barrier": { "issue_cycles": 8 },
      "message": { "issue_cycles": 16 },
      "nop": { "issue_cycles": 1 },
      "terminate": { "issue_cycles": 1 }
    },
    "model_config": {}
  },
  "topology": {
    "root": {
      "name": "soc", "type": "soc",
      "children": [
        { "name": "vram", "type": "gpu_memory" },
        {
          "name": "iod[0:2]", "type": "iod",
          "config": [{ "key": "num_hbm_stacks", "value": "4" }]
        },
        {
          "name": "xcd[0:8]", "type": "xcd",
          "children": [
            { "name": "l2", "type": "l2_cache" },
            { "name": "cp", "type": "command_processor" },
            {
              "name": "se[0:4]", "type": "shader_engine",
              "children": [{
                "name": "cu[0:9]", "type": "compute_unit",
                "config": [
                  { "key": "num_wf_slots", "value": "32" },
                  { "key": "sgprs_per_wf", "value": "104" },
                  { "key": "vgprs_per_wf", "value": "512" },
                  { "key": "lds_size_kb", "value": "160" }
                ]
              }]
            }
          ]
        }
      ]
    },
    "links": [
      {
        "pattern": "xcd[i].cp.req_[j*9+k] -> xcd[i].se[j].cu[k].cpl",
        "for_ranges": [
          { "var_name": "i", "start": 0, "end": 8 },
          { "var_name": "j", "start": 0, "end": 4 },
          { "var_name": "k", "start": 0, "end": 9 }
        ],
        "latency": 1, "weight": 2
      },
      {
        "pattern": "xcd[i].se[j].cu[k].req -> xcd[i].l2.cpl_[j*9+k]",
        "for_ranges": [
          { "var_name": "i", "start": 0, "end": 8 },
          { "var_name": "j", "start": 0, "end": 4 },
          { "var_name": "k", "start": 0, "end": 9 }
        ],
        "latency": 1, "weight": 10
      },
      {
        "pattern": "xcd[i].l2.req -> iod[i/4].msc.cpl_[i%4]",
        "for_ranges": [{ "var_name": "i", "start": 0, "end": 8 }],
        "latency": 1, "weight": 3
      },
      {
        "pattern": "iod[i].peer_req -> iod[j].peer_cpl",
        "for_ranges": [
          { "var_name": "i", "start": 0, "end": 2 },
          { "var_name": "j", "start": 0, "end": 2 }
        ],
        "where_expr": "i != j",
        "latency": 1, "weight": 1
      },
      {
        "pattern": "xcd[i].se[j].cu[k].adj_req -> xcd[i].se[j].cu[k+1].adj_cpl",
        "for_ranges": [
          { "var_name": "i", "start": 0, "end": 8 },
          { "var_name": "j", "start": 0, "end": 4 },
          { "var_name": "k", "start": 0, "end": 8 }
        ],
        "latency": 1, "weight": 2
      },
      {
        "pattern": "xcd[i].se[j].cu[k+1].adj_req_r -> xcd[i].se[j].cu[k].adj_cpl_r",
        "for_ranges": [
          { "var_name": "i", "start": 0, "end": 8 },
          { "var_name": "j", "start": 0, "end": 4 },
          { "var_name": "k", "start": 0, "end": 8 }
        ],
        "latency": 1, "weight": 2
      }
    ]
  }
}
